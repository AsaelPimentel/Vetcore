@model object
@{
    string entidad = ViewBag.Entidad;
}

<div class="modal fade" id="modalCatalogo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-modern" style="border: none; padding: 0; overflow: hidden; border-radius: 16px;">
            <div class="modal-header border-0 px-4 pt-4 pb-3" style="background-color: #f8fafc;">
                <div>
                    <h3 class="headline mb-1" style="color: #0f172a; font-size: 1.25rem;">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i> Editar Registro (@entidad)
                    </h3>
                    <p class="body-text mb-0 small text-muted">Modifique los datos correspondientes para este catálogo.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body px-4 pb-4 pt-3">
                <form id="frmEditarCatalogo">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="entidad" value="@entidad" />

                    <div class="p-3 rounded-3 mb-3" style="background-color: #f1f5f9; border: 1px solid #e2e8f0;">
                        <div class="row g-3">
                            @if (entidad == "Roles")
                            {
                                var item = Model as Vetcore.Models.Roles;
                                <input type="hidden" name="id" value="@item.IdRol" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nombre</label>
                                    <input type="text" name="Nombre" class="form-control" value="@item.Nombre" required autocomplete="off" />
                                </div>
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Descripción</label>
                                    <textarea name="Descripcion" class="form-control" rows="2">@item.Descripcion</textarea>
                                </div>
                            }
                            else if (entidad == "Puestos")
                            {
                                var item = Model as Vetcore.Models.Puestos;
                                <input type="hidden" name="id" value="@item.IdPuesto" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nombre</label>
                                    <input type="text" name="Nombre" class="form-control" value="@item.Nombre" required autocomplete="off" />
                                </div>
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nivel de Acceso (1 a 3)</label>
                                    <input type="number" name="NivelAcceso" class="form-control" value="@item.NivelAcceso" min="1" max="3" />
                                </div>
                            }
                            else if (entidad == "Razas")
                            {
                                var item = Model as Vetcore.Models.Razas;
                                <input type="hidden" name="id" value="@item.IdRaza" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Especie</label>
                                    @Html.DropDownList("IdEspecie", null, new { @class = "form-control" })
                                </div>
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nombre de Raza</label>
                                    <input type="text" name="Nombre" class="form-control" value="@item.Nombre" required autocomplete="off" />
                                </div>
                            }
                            else if (entidad == "Categorias")
                            {
                                var item = Model as Vetcore.Models.Categorias;
                                <input type="hidden" name="id" value="@item.IdCategoria" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nombre</label>
                                    <input type="text" name="Nombre" class="form-control" value="@item.Nombre" required autocomplete="off" />
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="form-check p-3 rounded bg-white border">
                                        <input class="form-check-input" type="checkbox" name="EsServicio" value="true" id="EsServicioEdit" @(item.EsServicio == true ? "checked" : "")>
                                        <label class="form-check-label fw-bold text-dark small ms-1" for="EsServicioEdit">
                                            ¿Es un servicio intangible? <span class="text-muted fw-normal d-block" style="font-size: 0.8rem;">(No maneja inventario o stock físico en farmacia/POS)</span>
                                        </label>
                                    </div>
                                </div>
                            }
                            else if (entidad == "Jaulas")
                            {
                                var item = Model as Vetcore.Models.Jaulas;
                                <input type="hidden" name="id" value="@item.IdJaula" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Código</label>
                                    <input type="text" name="Codigo" class="form-control" value="@item.Codigo" required autocomplete="off" />
                                </div>
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Tamaño</label>
                                    <select name="Tamano" class="form-control">
                                        <option value="Pequeña" @(item.Tamano == "Pequeña" ? "selected" : "")>Pequeña (Gatos / Perros chicos)</option>
                                        <option value="Mediana" @(item.Tamano == "Mediana" ? "selected" : "")>Mediana</option>
                                        <option value="Grande" @(item.Tamano == "Grande" ? "selected" : "")>Grande (Razas grandes)</option>
                                    </select>
                                </div>
                            }
                            else // Especies
                            {
                                var item = Model as Vetcore.Models.Especies;
                                <input type="hidden" name="id" value="@item.IdEspecie" />
                                <div class="col-12">
                                    <label class="label mb-1 fw-semibold text-secondary">Nombre</label>
                                    <input type="text" name="Nombre" class="form-control" value="@item.Nombre" required autocomplete="off" />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="btnActualizarCatalogo" class="btn btn-primary px-4 shadow-sm d-flex align-items-center gap-2">
                            <i class="fa-solid fa-save"></i> <span>Guardar Cambios</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>