        function loadTable(search, page) {
            $('#table-container').css('opacity', '0.5');
            $.ajax({
                url: '@Url.Action("Index", "Empleados")',
                type: 'GET',
                data: { search: search, page: page },
                success: function (result) {
                    $('#table-container').html(result).css('opacity', '1');
                }
            });
        }

        function abrirModalCreate() {
            $.get('@Url.Action("Create", "Empleados")', function (data) {
                $('#modal-container').html(data);
                $('#modalCreateEmpleado').modal('show');
            });
        }

        function abrirModalEdit(id) {
            $.get('@Url.Action("Edit", "Empleados")/' + id, function (data) {
                $('#modal-container').html(data);
                $('#modalEditEmpleado').modal('show');
            });
        }

