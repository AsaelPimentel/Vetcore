@using Vetcore.Helpers <!-- 1. IMPORTAMOS LOS ROLES Y EXTENSIONES -->
@model Vetcore.Models.Mascotas

@{
    ViewBag.Title = "Expediente Clínico";
    var historial = ViewBag.HistorialConsultas as IEnumerable<Vetcore.Models.Consultas>;
}

<!-- ENCABEZADO -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="@Url.Action("Index", "Mascotas")" class="btn btn-icon btn-outlined" title="Volver a pacientes">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h3 class="headline mb-0">Expediente Clínico</h3>
            <p class="body-text mb-0 small">Historial médico de <strong class="text-primary">@Model.Nombre</strong></p>
        </div>
    </div>

    <!-- MIGRACIÓN A CLAIMS: Cambiamos Session por Context -->
    @if (Context.IsMedicoOrAdmin())
    {
        <button onclick="abrirModalConsulta(@ViewBag.IdExpediente)" class="btn btn-primary px-4 shadow-sm">
            <i class="fa-solid fa-notes-medical me-1"></i> Nueva Consulta
        </button>
    }
</div>

<div class="row g-4">
    <!-- COLUMNA IZQUIERDA: PERFIL DEL PACIENTE -->
    <div class="col-md-4">
        <div class="card-modern p-4 text-center sticky-top" style="top: 90px; border-top: 4px solid var(--vc-primary);">
            <div style="width: 90px; height: 90px; background: linear-gradient(135deg, var(--vc-primary-light) 0%, #e0f2fe 100%); color: var(--vc-primary); font-size: 3rem; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin: 0 auto 15px auto; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                <i class="fa-solid fa-dog"></i>
            </div>
            <h4 class="headline mb-1">@Model.Nombre</h4>

            <div class="d-flex justify-content-center gap-2 mb-4">
                <span class="badge bg-light text-dark border px-3 rounded-pill"><i class="fa-solid fa-paw text-muted me-1"></i> @(Model.Razas?.Nombre ?? "Sin raza")</span>
                <span class="badge bg-light text-dark border px-3 rounded-pill"><i class="fa-solid @(Model.Sexo == "M" ? "fa-mars text-info" : "fa-venus text-danger") me-1"></i> @(Model.Sexo == "M" ? "Macho" : "Hembra")</span>
            </div>

            <div class="border-top pt-3 text-start">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span class="text-muted small fw-bold"><i class="fa-solid fa-user me-1"></i> Dueño</span>
                    <span class="body-text small fw-medium">@(Model.Propietarios?.Nombre) @(Model.Propietarios?.Apellidos)</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span class="text-muted small fw-bold"><i class="fa-solid fa-weight-scale me-1"></i> Peso Actual</span>
                    <span class="body-text small fw-medium">@(Model.PesoActual?.ToString("0.00") ?? "0") Kg</span>
                </div>
                <div class="d-flex justify-content-between pt-1">
                    <span class="text-muted small fw-bold"><i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Alergias</span>
                    <span class="body-text small fw-medium @(string.IsNullOrEmpty(Model.Alergias) ? "text-muted" : "text-danger")">
                        @(string.IsNullOrEmpty(Model.Alergias) ? "Ninguna" : Model.Alergias)
                    </span>
                </div>

                <!-- GRÁFICA DE EVOLUCIÓN -->
                <div class="mt-4 pt-3 border-top text-start">
                    <h6 class="text-uppercase small fw-bold text-muted mb-2"><i class="fa-solid fa-chart-line text-primary me-1"></i> Evolución (Peso y Temp)</h6>
                    <canvas id="graficaEvolucion" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA: TIMELINE DE CONSULTAS -->
    <div class="col-md-8">
        @if (historial == null || !historial.Any())
        {
            <div class="card-modern p-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 400px; background-color: #f8fafc; border: 2px dashed #cbd5e1;">
                <div style="background-color: #e2e8f0; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-folder-open text-muted" style="font-size: 2.5rem;"></i>
                </div>
                <h4 class="headline text-dark mb-2">Expediente en blanco</h4>
                <p class="body-text text-muted mb-4" style="max-width: 300px;">Este paciente aún no tiene notas médicas ni consultas previas registradas.</p>

                <!-- MIGRACIÓN A CLAIMS: Cambiamos Session por Context -->
                @if (Context.IsMedicoOrAdmin())
                {
                    <button onclick="abrirModalConsulta(@ViewBag.IdExpediente)" class="btn btn-primary px-4 shadow-sm">Registrar primera consulta</button>
                }
            </div>
        }
        else
        {
            <!-- Contenedor de la línea de tiempo -->
            <div style="border-left: 3px solid #e2e8f0; padding-left: 30px; margin-left: 15px; position: relative;">

                @foreach (var item in historial)
                {
                    <div class="card-modern p-4 mb-4 shadow-sm" style="position: relative; border: 1px solid #e2e8f0;">
                        <!-- Punto del Timeline -->
                        <div style="position: absolute; left: -41px; top: 24px; width: 20px; height: 20px; background-color: var(--vc-primary); border: 4px solid white; border-radius: 50%; box-shadow: 0 0 0 2px #e2e8f0;"></div>

                        <!-- Cabecera de la Consulta -->
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div class="d-flex gap-2">
                                <!-- 3. NULL SAFETY EN LA FECHA -->
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 shadow-sm"><i class="fa-regular fa-calendar text-primary me-1"></i> @(item.Fecha?.ToString("dd/MMM/yyyy - HH:mm") ?? "Fecha no disponible")</span>
                                <span class="badge rounded-pill px-3 py-2 shadow-sm" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;"><i class="fa-solid fa-user-doctor me-1"></i> @(item.Empleados?.Nombre ?? "Médico Desconocido")</span>
                            </div>

                            <!-- Botones de Acción -->
                            <div>
                                @if (!string.IsNullOrEmpty(item.RecetaMedica))
                                {
                                    <a href="@Url.Action("ImprimirReceta", "Expedientes", new { id = item.IdConsulta })" target="_blank" class="btn btn-sm" style="background-color: #ecfdf5; color: #059669; border: 1px solid #6ee7b7; padding: 4px 12px; border-radius: 6px;" title="Imprimir Receta">
                                        <i class="fa-solid fa-print me-1"></i> Receta
                                    </a>
                                }

                                <!-- MIGRACIÓN A CLAIMS: Cambiamos Session por Context -->
                                @if (Context.IsMedicoOrAdmin())
                                {
                                    if (item.Fecha.HasValue && item.Fecha.Value.Date == DateTime.Today)
                                    {
                                        <button onclick="abrirModalEditar(@item.IdConsulta)" class="btn btn-sm btn-icon ms-1" style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a;" title="Editar Consulta (Solo hoy)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Signos Vitales -->
                        <div class="d-flex gap-3 mb-4">
                            <div class="bg-light rounded p-2 px-3 flex-grow-1 border" style="background-color: #f8fafc !important;">
                                <span class="text-muted small fw-bold d-block mb-1"><i class="fa-solid fa-weight-scale me-1"></i> Peso</span>
                                <span class="fw-bold" style="color: #334155;">@(item.PesoKg?.ToString("0.00") ?? "-") Kg</span>
                            </div>
                            <div class="bg-light rounded p-2 px-3 flex-grow-1 border" style="background-color: #f8fafc !important;">
                                <span class="text-muted small fw-bold d-block mb-1"><i class="fa-solid fa-temperature-half me-1"></i> Temperatura</span>
                                <span class="fw-bold" style="color: #334155;">@(item.Temperatura?.ToString("0.0") ?? "-") °C</span>
                            </div>
                        </div>

                        <!-- Notas y Observaciones Clínicas -->
                        <div class="d-flex flex-column gap-3">
                            @if (!string.IsNullOrEmpty(item.Sintomas))
                            {
                                <div>
                                    <span class="fw-bold small d-block mb-1" style="color: #475569;"><i class="fa-solid fa-clipboard-list me-1"></i> Síntomas Observados</span>
                                    <div class="body-text p-3" style="background-color: #f1f5f9; border-radius: 8px; border: 1px solid #e2e8f0; line-height: 1.5;">@item.Sintomas</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.Diagnostico))
                            {
                                <div>
                                    <span class="fw-bold small d-block mb-1" style="color: #b45309;"><i class="fa-solid fa-microscope me-1"></i> Diagnóstico Médico</span>
                                    <div class="body-text p-3" style="background-color: #fffbeb; border-radius: 8px; border: 1px solid #fde68a; border-left: 4px solid #f59e0b; line-height: 1.5;">@item.Diagnostico</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.RecetaMedica))
                            {
                                <div>
                                    <span class="fw-bold small d-block mb-1" style="color: #047857;"><i class="fa-solid fa-prescription-bottle-medical me-1"></i> Receta / Tratamiento</span>
                                    <div class="body-text p-3" style="background-color: #ecfdf5; border-radius: 8px; border: 1px solid #a7f3d0; border-left: 4px solid #10b981; line-height: 1.5; white-space: pre-wrap;">@item.RecetaMedica</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.NotasAdicionales))
                            {
                                <div>
                                    <span class="fw-bold small d-block mb-1" style="color: #4338ca;"><i class="fa-solid fa-paperclip me-1"></i> Notas Internas Adicionales</span>
                                    <div class="body-text p-3" style="background-color: #eef2ff; border-radius: 8px; border: 1px solid #c7d2fe; border-left: 4px solid #6366f1; line-height: 1.5;">@item.NotasAdicionales</div>
                                </div>
                            }
                        </div>

                        <!-- Botón de Estudio Adjunto -->
                        @if (!string.IsNullOrEmpty(item.ArchivoEstudio))
                        {
                            <div class="mt-2 pt-2 border-top">
                                <a href="~/Content/Estudios/@item.ArchivoEstudio" target="_blank" class="btn btn-sm btn-light border fw-bold text-dark shadow-sm">
                                    <i class="fa-solid fa-paperclip text-primary me-1"></i> Ver Estudio Adjunto
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Contenedor para inyectar modales -->
<div id="modal-container"></div>

@section Scripts {
    <!-- Incluir librería de gráficas Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Cargar Gráfica al inicio
        $(document).ready(function() {
            $.get('@Url.Action("DatosEvolucion", "Expedientes", new { idMascota = Model.IdMascota })', function(data) {
                if(data && data.labels && data.labels.length > 0) {
                    var ctx = document.getElementById('graficaEvolucion').getContext('2d');
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [
                                { label: 'Peso (Kg)', data: data.pesos, borderColor: '#0ea5e9', backgroundColor: '#e0f2fe', tension: 0.3, fill: true },
                                { label: 'Temp (°C)', data: data.temperaturas, borderColor: '#f59e0b', backgroundColor: '#fef3c7', tension: 0.3 }
                            ]
                        }
                    });
                }
            });
        });

        // 1. Abrir Modal Nueva Consulta
        function abrirModalConsulta(idExpediente) {
            $.get('@Url.Action("RegistrarConsulta", "Expedientes")', { idExpediente: idExpediente })
            .done(function (data) {
                $('#modal-container').html(data);
                $('#modalConsulta').modal('show');
            })
            .fail(function () {
                alert("Error al cargar el formulario.");
            });
        }

        // 2. Guardar Nueva Consulta (ACTUALIZADO PARA ENVIAR ARCHIVOS)
        $(document).on('click', '#btnGuardarConsulta', function () {
            var formElement = $('#frmCreateConsulta')[0];
            var formData = new FormData(formElement); // Obligatorio para subir archivos en AJAX

            var btn = $(this);
            btn.html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Guardando...').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("RegistrarConsulta", "Expedientes")',
                type: 'POST',
                data: formData,
                processData: false, // Importante para que jQuery no procese los archivos como string
                contentType: false, // Importante para que mantenga el formato multipart/form-data
                success: function (response) {
                    if (response.success) {
                        $('#modalConsulta').modal('hide');
                        location.reload();
                    } else {
                        // En caso de error de validación, volvemos a cargar el formulario
                        $('#modal-container').html(response);
                        $('#modalConsulta').modal('show');
                    }
                },
                error: function () {
                    alert("Error de conexión al guardar.");
                    btn.html('<i class="fa-solid fa-save me-1"></i> Guardar Consulta').prop('disabled', false);
                }
            });
        });

        // 3. Abrir modal Editar
        function abrirModalEditar(idConsulta) {
            $.get('@Url.Action("EditarConsulta", "Expedientes")', { id: idConsulta })
            .done(function (data) {
                $('#modal-container').html(data);
                $('#modalEditarConsulta').modal('show');
            })
            .fail(function () {
                alert("Error al cargar la consulta.");
            });
        }

        // 4. Actualizar Consulta
        $(document).on('click', '#btnActualizarConsulta', function () {
            var form = $('#frmEditConsulta');
            var btn = $(this);
            btn.html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Actualizando...');

            $.post('@Url.Action("EditarConsulta", "Expedientes")', form.serialize())
            .done(function (response) {
                if (response.success) {
                    $('#modalEditarConsulta').modal('hide');
                    location.reload();
                } else if (response.message) {
                    alert(response.message);
                    btn.html('<i class="fa-solid fa-pen-to-square me-1"></i> Actualizar');
                } else {
                    $('#modal-container').html(response);
                    $('#modalEditarConsulta').modal('show');
                }
            });
        });
    </script>
}