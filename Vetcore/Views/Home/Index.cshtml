            <div>
                <h4 class="headline mb-1" style="font-size: 1.15rem; color: #b91c1c;"><i class="fa-solid fa-triangle-exclamation me-2"></i> Alertas de Stock en Farmacia</h4>
                <p class="body-text small text-muted mb-0">Productos que han alcanzado o caído por debajo de su stock mínimo permitido.</p>
            </div>
            <a href="@Url.Action("Index", "Productos")" class="btn btn-outlined btn-sm">Ir a Inventario <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>
        <div class="table-responsive">
            <table class="table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Producto</th>
                        <th>Categoría</th>
                        <th class="text-center">Stock Actual</th>
                        <th class="text-center">Stock Mínimo</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var stockBajoList = ViewBag.ProductosStockBajoLista as List<Vetcore.Models.Productos>;
                    }
                    @if (stockBajoList == null || !stockBajoList.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-circle-check text-success fs-3 mb-2 d-block"></i>
                                Excelente. No hay productos con stock bajo en este momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var prod in stockBajoList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@prod.Nombre</td>
                                <td><span class="badge bg-light text-dark border">@(prod.Categorias != null ? prod.Categorias.Nombre : "General")</span></td>
                                <td class="text-center fw-bold text-danger">@prod.StockActual</td>
                                <td class="text-center text-muted">@prod.StockMinimo</td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Index", "Productos", new { search = prod.Nombre })" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-box-open me-1"></i> Surtir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

