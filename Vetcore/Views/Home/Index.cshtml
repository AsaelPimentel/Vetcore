<div class="card-modern shadow-sm">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-white" style="border-radius: 12px 12px 0 0;">
        <div>
            <h4 class="headline mb-1" style="font-size: 1.15rem;"><i class="fa-regular fa-clock text-primary me-2"></i> Próximos en ser atendidos</h4>
            <p class="body-text small text-muted mb-0">Citas programadas para las próximas horas del día de hoy.</p>
        </div>
        <a href="@Url.Action("Index", "Citas")" class="btn btn-outlined btn-sm">Ver Calendario Completo <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>
    <div class="table-responsive">
        <table class="table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 110px;">Hora</th>
                    <th>Paciente & Propietario</th>
                    <th>Servicio / Motivo</th>
                    <th>Especialista</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end pe-4">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div style="color: #cbd5e1; font-size: 2.5rem; margin-bottom: 10px;">
                                <i class="fa-solid fa-mug-hot"></i>
                            </div>
                            <p class="body-text fw-medium text-dark mb-0">No hay pacientes pendientes en agenda para las próximas horas.</p>
                            <small class="text-muted">Las citas programadas aparecerán aquí.</small>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var cita in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border px-2 py-2 fw-semibold" style="font-size: 0.85rem;">
                                    <i class="fa-regular fa-clock text-muted me-1"></i> @cita.FechaHora.ToString("hh:mm tt")
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@cita.Mascotas.Nombre</div>
                                <small class="text-muted"><i class="fa-solid fa-user me-1 text-secondary"></i> @cita.Mascotas.Propietarios.Nombre @cita.Mascotas.Propietarios.Apellidos</small>
                            </td>
                            <td>
                                <div class="fw-medium text-secondary">@cita.Tipo</div>
                                <div class="text-muted small text-truncate" style="max-width: 220px;" title="@cita.Motivo">
                                    @(string.IsNullOrEmpty(cita.Motivo) ? "Sin observaciones previas" : cita.Motivo)
                                </div>
                            </td>
                            <td>
                                <div class="body-text fw-medium text-dark">
                                    <i class="fa-solid fa-user-doctor text-primary me-1"></i> @cita.Empleados.Nombre @cita.Empleados.Apellidos
                                </div>
                            </td>
                            <td class="text-center">
                                @if (cita.Estado == "Pendiente")
                                {
                                    <span class="badge px-3 py-2" style="background-color: #fef08a; color: #854d0e; font-weight: 550;">Pendiente</span>
                                }
                                else if (cita.Estado == "Atendida")
                                {
                                    <span class="badge px-3 py-2" style="background-color: #d1fae5; color: #047857; font-weight: 550;">Atendida</span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-2" style="background-color: #fee2e2; color: #b91c1c; font-weight: 550;">@cita.Estado</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Index", "Mascotas", new { search = cita.Mascotas.Nombre })" class="btn btn-icon btn-outlined btn-sm" title="Buscar Paciente en Directorio">
                                    <i class="fa-solid fa-paw text-primary"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .hover-elevate:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -4px rgba(0, 0, 0, 0.05) !important;
    }
</style>