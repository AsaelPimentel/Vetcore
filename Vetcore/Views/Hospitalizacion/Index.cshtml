<!-- MAPA DE JAULAS (GRID VISUAL) -->
<div class="row g-4">
    @foreach (var jaula in Model)
    {
        var hospActual = activas.FirstOrDefault(h => h.IdJaula == jaula.IdJaula);
        bool ocupada = hospActual != null;

        <div class="col-md-4 col-xl-3">
            <div class="card h-100 shadow-sm border-0" style="border-radius: 16px; border-top: 5px solid @(ocupada ? "#ef4444" : "#10b981") !important;">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
