<div id="modalContainer"></div>

@section Scripts {
    <script>
        function abrirModalIngreso() {
            $.get('@Url.Action("Ingresar", "Hospitalizacion")', function (data) {
                $('#modalContainer').html(data);
                $('#modalIngreso').modal('show');
            });
        }

        $(document).on('click', '#btnGuardarIngreso', function () {
            var form = $('#frmIngreso');
            var btn = $(this);
            btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Guardando...').prop('disabled', true);

            $.post('@Url.Action("Ingresar", "Hospitalizacion")', form.serialize(), function (response) {
                if (response.success) {
                    $('#modalIngreso').modal('hide');
                    location.reload();
                } else {
                    $('#modalContainer').html(response);
                    $('#modalIngreso').modal('show');
                }
            });
        });
    </script>
}