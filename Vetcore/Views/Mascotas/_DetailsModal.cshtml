@model Vetcore.Models.Mascotas

<div class="modal fade" id="modalDetailsMascota" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content card-modern" style="border: none; padding: 0; overflow: hidden; border-radius: 16px;">

            <!-- Cabecera con Avatar e Información Principal -->
            <div class="modal-header border-0 px-4 pt-4 pb-3" style="background-color: #f8fafc;">
                <div class="d-flex align-items-center gap-3 w-100">
                    <div style="width: 54px; height: 54px; min-width: 54px; background: linear-gradient(135deg, #0284c7, #0ea5e9); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; box-shadow: 0 4px 6px -1px rgba(2, 132, 199, 0.25);">
                        <i class="fa-solid fa-paw"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="headline mb-0" style="color: #0f172a; font-size: 1.2rem;">@Model.Nombre</h4>
                            @if (Model.Fallecido == true)
                            {
                                <span class="badge px-2 py-1" style="background-color: #fee2e2; color: #b91c1c; font-size: 0.75rem;">Finado</span>
                            }
                            else
                            {
                                <span class="badge px-2 py-1" style="background-color: #d1fae5; color: #047857; font-size: 0.75rem;">Activo</span>
                            }
                        </div>
                        <p class="body-text text-muted mb-0 small">
                            <i class="fa-solid fa-dna text-secondary me-1"></i> @Model.Razas.Nombre
                        </p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
            </div>

            <div class="modal-body px-4 py-3">
                <!-- Información del Propietario -->
                <h6 class="text-uppercase small fw-bold text-muted mb-2" style="letter-spacing: 0.5px;">
                    <i class="fa-solid fa-user me-1 text-primary"></i> Propietario Responsable
                </h6>
                <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                    <div>
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">@Model.Propietarios.Nombre @Model.Propietarios.Apellidos</div>
                        <small class="text-muted"><i class="fa-solid fa-phone me-1"></i> @Model.Propietarios.Telefono</small>
                    </div>
                    <a href="tel:@Model.Propietarios.Telefono" class="btn btn-sm btn-light border shadow-sm">
                        <i class="fa-solid fa-phone text-success"></i>
                    </a>
                </div>

                <!-- Detalles Clínicos / Biométricos -->
                <h6 class="text-uppercase small fw-bold text-muted mb-2" style="letter-spacing: 0.5px;">
                    <i class="fa-solid fa-notes-medical me-1 text-primary"></i> Ficha Biométrica
                </h6>
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="p-2.5 rounded-3 text-center" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">Sexo</span>
                            <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Model.Sexo == "M" ? "Macho" : "Hembra")</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2.5 rounded-3 text-center" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">Peso Actual</span>
                            <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Model.PesoActual?.ToString() ?? "0.00") kg</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2.5 rounded-3 text-center" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">Nacimiento</span>
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "N/D")</span>
                        </div>
                    </div>
                </div>

                <!-- Alergias / Observaciones -->
                <h6 class="text-uppercase small fw-bold text-muted mb-2" style="letter-spacing: 0.5px;">
                    <i class="fa-solid fa-triangle-exclamation me-1 text-warning"></i> Alergias y Condiciones
                </h6>
                <div class="p-3 rounded-3 mb-2" style="background-color: #fffbeb; border: 1px solid #fde68a; color: #92400e; font-size: 0.9rem;">
                    @(string.IsNullOrEmpty(Model.Alergias) ? "No registra alergias o condiciones especiales conocidas." : Model.Alergias)
                </div>
            </div>

            <!-- Footer Limpio Solo con Cerrar -->
            <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-end">
                <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>