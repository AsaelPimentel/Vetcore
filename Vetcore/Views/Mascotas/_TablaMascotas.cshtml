@using Vetcore.Helpers <!-- Importamos la clase de Roles y Extensiones -->
@model IEnumerable<Vetcore.Models.Mascotas>

<div class="table-responsive">
    <table class="table-modern">
        <thead>
            <tr>
                <th>Paciente</th>
                <th>Dueño</th>
                <th>Detalles</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center body-text py-4">No se encontraron pacientes con esos parámetros.</td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="btn-icon" style="background-color: var(--vc-primary-hover); color: white; border-radius: 50%;">
                                <i class="fa-solid fa-paw"></i>
                            </div>
                            <div>
                                <div class="headline" style="font-size: 0.95rem; margin-bottom: 0;">@item.Nombre</div>
                                <!-- NULL SAFETY: Evita error si la raza es nula -->
                                <small class="body-text" style="font-size: 0.8rem;">@(item.Razas?.Nombre ?? "Sin raza registrada")</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <!-- NULL SAFETY: Protegemos los datos del dueño -->
                        <div class="body-text fw-medium text-dark">@(item.Propietarios?.Nombre) @(item.Propietarios?.Apellidos)</div>
                        <small class="text-muted"><i class="fa-solid fa-phone me-1"></i> @(item.Propietarios?.Telefono ?? "Sin contacto")</small>
                    </td>
                    <td>
                        <div class="body-text" style="font-size: 0.85rem;">
                            <strong>Sexo:</strong> @(item.Sexo == "M" ? "Macho" : "Hembra")<br />
                            <strong>Peso:</strong> @(item.PesoActual.HasValue ? item.PesoActual + " kg" : "N/D")
                        </div>
                    </td>
                    <td>
                        @if (item.Fallecido == true)
                        {
                            <span class="label" style="background-color: #f1f5f9; color: #475569; padding: 4px 8px; border-radius: var(--vc-radius-sm);">
                                <i class="fa-solid fa-cross me-1"></i> Finado
                            </span>
                        }
                        else
                        {
                            <span class="label" style="background-color: #d1fae5; color: #047857; padding: 4px 8px; border-radius: var(--vc-radius-sm);">
                                Activo
                            </span>
                        }
                    </td>
                    <td class="text-end">
                        <!-- Editar: Visible para todos (Recepción suele actualizar peso o teléfono) -->
                        <button onclick="abrirModalEdit(@item.IdMascota)" class="btn btn-icon btn-outlined" title="Editar Paciente">
                            <i class="fa-solid fa-pen text-primary"></i>
                        </button>
