@model IEnumerable<Vetcore.Models.KardexInventario>

@{
    ViewBag.Title = "Bitácora de Kardex";
}

<!-- Encabezado con Botón de Regresar y Botón de Imprimir -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center gap-3">
        <div style="width: 50px; height: 50px; background-color: #f1f5f9; color: #334155; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
            <i class="fa-solid fa-clock-rotate-left"></i>
        </div>
        <div>
            <h3 class="headline mb-1" style="color: #1e293b; font-weight: 700;">Auditoría e Historial de Movimientos</h3>
            <p class="body-text text-muted mb-0 small">Registro de entradas, salidas, mermas y usos clínicos en farmacia.</p>
        </div>
    </div>

    <!-- Botones de Acción Superior -->
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Productos")" class="btn btn-light border px-3 shadow-sm d-flex align-items-center gap-2 text-secondary">
            <i class="fa-solid fa-arrow-left"></i> <span>Regresar a Inventario</span>
        </a>
        <button type="button" id="btnImprimirKardex" class="btn btn-outlined px-4 shadow-sm d-flex align-items-center gap-2">
            <i class="fa-solid fa-print"></i> <span>Imprimir Reporte</span>
        </button>
    </div>
</div>

<!-- Filtros Avanzados (Categoría, Tipo y Fechas) -->
<div class="card-modern p-4 shadow-sm border-0 mb-4" style="background: #ffffff; border-radius: 16px;">
    @using (Html.BeginForm("KardexHistorial", "Productos", FormMethod.Get, new { id = "formFiltroKardex" }))
    {
        <div class="row g-3 align-items-end">
            <!-- Filtro por Categoría -->
            <div class="col-md-3">
                <label class="label mb-1 fw-semibold text-secondary">Categoría</label>
                <select name="idCategoria" class="form-control">
                    <option value="">Todas las categorías</option>
                    @if (ViewBag.ListaCategorias != null)
                    {
                        foreach (var cat in (IEnumerable<Vetcore.Models.Categorias>)ViewBag.ListaCategorias)
                        {
                            bool sel = ViewBag.CategoriaSeleccionada != null && (int)ViewBag.CategoriaSeleccionada == cat.IdCategoria;
                            <option value="@cat.IdCategoria" @(sel ? "selected=selected" : "")>@cat.Nombre</option>
                        }
                    }
                </select>
            </div>

            <!-- Filtro por Tipo de Movimiento -->
            <div class="col-md-3">
                <label class="label mb-1 fw-semibold text-secondary">Tipo de Movimiento</label>
                <select name="tipoMovimiento" class="form-control">
                    <option value="">Todos los tipos</option>
                    <option value="CompraProveedor" @(ViewBag.TipoMovimientoSeleccionado == "CompraProveedor" ? "selected" : "")>Compra a Proveedor</option>
                    <option value="DevolucionCliente" @(ViewBag.TipoMovimientoSeleccionado == "DevolucionCliente" ? "selected" : "")>Devolución de Cliente</option>
                    <option value="VentaPOS" @(ViewBag.TipoMovimientoSeleccionado == "VentaPOS" ? "selected" : "")>Venta POS</option>
                    <option value="UsoClinico" @(ViewBag.TipoMovimientoSeleccionado == "UsoClinico" ? "selected" : "")>Uso Clínico</option>
                    <option value="RecetaMedica" @(ViewBag.TipoMovimientoSeleccionado == "RecetaMedica" ? "selected" : "")>Receta Médica</option>
                    <option value="MermaCaducidad" @(ViewBag.TipoMovimientoSeleccionado == "MermaCaducidad" ? "selected" : "")>Merma por Caducidad</option>
                    <option value="MermaDano" @(ViewBag.TipoMovimientoSeleccionado == "MermaDano" ? "selected" : "")>Merma por Daño</option>
                    <option value="MermaRobo" @(ViewBag.TipoMovimientoSeleccionado == "MermaRobo" ? "selected" : "")>Merma por Robo</option>
                    <option value="AjusteEntrada" @(ViewBag.TipoMovimientoSeleccionado == "AjusteEntrada" ? "selected" : "")>Ajuste Entrada</option>
                    <option value="AjusteSalida" @(ViewBag.TipoMovimientoSeleccionado == "AjusteSalida" ? "selected" : "")>Ajuste Salida</option>
                </select>
            </div>

            <!-- Fecha Inicio -->
            <div class="col-md-2">
                <label class="label mb-1 fw-semibold text-secondary">Fecha Inicio</label>
                <input type="date" name="fechaInicio" class="form-control" value="@Request.QueryString["fechaInicio"]" />
            </div>

            <!-- Fecha Fin -->
            <div class="col-md-2">
                <label class="label mb-1 fw-semibold text-secondary">Fecha Fin</label>
                <input type="date" name="fechaFin" class="form-control" value="@Request.QueryString["fechaFin"]" />
            </div>

            <!-- Botón Filtrar -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 shadow-sm" title="Filtrar consulta">
                    <i class="fa-solid fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </div>
    }
</div>

<!-- Tabla de Movimientos -->
<div class="card-modern p-4 shadow-sm border-0" style="background: #ffffff; border-radius: 16px;">
    <div class="table-responsive">
        <table class="table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Fecha y Hora</th>
                    <th>Producto</th>
                    <th class="text-center">Tipo Movimiento</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Stock Resultante</th>
                    <th>Responsable</th>
                    <th class="pe-4">Motivo / Observación</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fs-2 mb-2 d-block"></i>
                            No hay movimientos registrados en el kardex con los filtros seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var k in Model)
                    {
                        bool esEntrada = k.TipoMovimiento == "CompraProveedor" ||
                                         k.TipoMovimiento == "DevolucionCliente" ||
                                         k.TipoMovimiento == "AjusteEntrada" ||
                                         k.TipoMovimiento == "Entrada";
                        <tr>
                            <td class="ps-4 small text-muted">
                                <i class="fa-regular fa-calendar me-1"></i> @(k.FechaHora != null ? ((DateTime)k.FechaHora).ToString("dd/MM/yyyy HH:mm") : "-")
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@k.Productos.Nombre</span>
                            </td>
                            <td class="text-center">
                                @switch (k.TipoMovimiento)
                                {
                                    case "CompraProveedor":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #d1fae5; color: #047857;">Compra Proveedor</span>
                                        break;
                                    case "DevolucionCliente":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #e0f2fe; color: #0284c7;">Devolución Cliente</span>
                                        break;
                                    case "VentaPOS":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #ede9fe; color: #6d28d9;">Venta POS</span>
                                        break;
                                    case "UsoClinico":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #fef3c7; color: #d97706;">Uso Clínico</span>
                                        break;
                                    case "RecetaMedica":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #fae8ff; color: #a21caf;">Receta Médica</span>
                                        break;
                                    case "MermaCaducidad":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #fee2e2; color: #b91c1c;">Merma (Caducado)</span>
                                        break;
                                    case "MermaDano":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #ffedd5; color: #c2410c;">Merma (Dañado)</span>
                                        break;
                                    case "MermaRobo":
                                        <span class="badge px-2.5 py-1.5" style="background-color: #f1f5f9; color: #334155;">Faltante / Robo</span>
                                        break;
                                    default:
                                        <span class="badge px-2.5 py-1.5" style="background-color: #f1f5f9; color: #475569;">@k.TipoMovimiento</span>
                                        break;
                                }
                            </td>
                            <td class="text-center fw-bold @(esEntrada ? "text-success" : "text-danger")">
                                @(esEntrada ? "+" : "-")@k.Cantidad
                            </td>
                            <td class="text-center fw-bold text-dark">
                                @k.StockResultante
                            </td>
                            <td>
                                <small class="text-dark fw-medium"><i class="fa-solid fa-user me-1 text-muted"></i> @k.Empleados.Nombre @k.Empleados.Apellidos</small>
                            </td>
                            <td class="pe-4 small text-muted">
                                @(string.IsNullOrEmpty(k.Motivo) ? "Sin observaciones" : k.Motivo)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Script para empaquetar los filtros actuales y abrir la vista de impresión en una pestaña nueva
        $(document).on('click', '#btnImprimirKardex', function () {
            var queryString = $('#formFiltroKardex').serialize();
            var url = '@Url.Action("KardexHistorialImprimir", "Productos")?' + queryString;
            window.open(url, '_blank');
        });
    </script>
}