                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
                <input type="text" id="inputFiltroReporte" class="form-control border-start-0 bg-light" placeholder="Filtrar por producto, código o categoría...">
            </div>
        </div>
        <div class="col-md-3 text-md-end">
            <span class="text-muted small">Mostrando <strong id="contadorVisibles">@Model.Count()</strong> registros</span>
        </div>
    </div>
</div>

