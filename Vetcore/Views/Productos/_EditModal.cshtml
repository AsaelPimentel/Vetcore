@model Vetcore.Models.Productos

<div class="modal fade" id="modalEditProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content card-modern" style="border: none; padding: 0; overflow: hidden; border-radius: 16px;">
            <!-- Cabecera del Modal -->
            <div class="modal-header border-0 px-4 pt-4 pb-3" style="background-color: #f8fafc;">
                <div>
                    <h3 class="headline mb-1" style="color: #0f172a; font-size: 1.25rem;">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i> Editar Producto / Suministro
                    </h3>
                    <p class="body-text mb-0 small text-muted">Modifique los costos, precios, existencias, lotes o caducidad del artículo en farmacia.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <!-- Cuerpo del Modal -->
            <div class="modal-body px-4 pb-4 pt-3">
                <form id="frmEditProducto">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.IdProducto)
                    @Html.HiddenFor(m => m.Activo)
                    <div class="p-3 rounded-3 mb-4" style="background-color: #f1f5f9; border: 1px solid #e2e8f0;">
                        <div class="row g-3">
                            <!-- Nombre del Producto -->
                            <div class="col-md-8">
                                <label class="label mb-1 fw-semibold text-secondary">Nombre del Producto</label>
                                @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control", autocomplete = "off", placeholder = "Ej. Amoxicilina 500mg" } })
                            </div>
                            <!-- Código de Barras -->
                            <div class="col-md-4">
                                <label class="label mb-1 fw-semibold text-secondary">Código de Barras</label>
                                @Html.EditorFor(m => m.CodigoBarras, new { htmlAttributes = new { @class = "form-control", autocomplete = "off", placeholder = "Opcional" } })
                            </div>
                            <!-- Categoría -->
                            <div class="col-md-6">
                                <label class="label mb-1 fw-semibold text-secondary">Categoría</label>
                                @Html.DropDownList("IdCategoria", null, new { @class = "form-control" })
                            </div>
                            <!-- Precio Costo -->
                            <div class="col-md-3">
                                <label class="label mb-1 fw-semibold text-secondary">Precio Costo ($)</label>
                                @Html.EditorFor(m => m.PrecioCosto, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" } })
                            </div>
                            <!-- Precio Venta -->
                            <div class="col-md-3">
                                <label class="label mb-1 fw-semibold text-secondary">Precio Venta ($)</label>
                                @Html.EditorFor(m => m.PrecioVenta, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" } })
                            </div>

                            <!-- Lote y Fecha de Caducidad -->
                            <div class="col-md-6">
                                <label class="label mb-1 fw-semibold text-secondary">Número de Lote</label>
                                @Html.EditorFor(m => m.Lote, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej. L-2026A", autocomplete = "off" } })
                            </div>
                            <div class="col-md-6">
                                <label class="label mb-1 fw-semibold text-secondary">Fecha de Caducidad</label>
                                @Html.EditorFor(m => m.FechaCaducidad, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            </div>

                            <!-- Stock Actual -->
                            <div class="col-md-6">
                                <label class="label mb-1 fw-semibold text-secondary">Stock Actual</label>
                                @Html.EditorFor(m => m.StockActual, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "0" } })
                            </div>
                            <!-- Stock Mínimo -->
                            <div class="col-md-6">
                                <label class="label mb-1 fw-semibold text-secondary">Stock Mínimo (Alerta)</label>
                                @Html.EditorFor(m => m.StockMinimo, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "0" } })
                            </div>
                        </div>
                    </div>
                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="btnActualizarProducto" class="btn btn-primary px-4 shadow-sm d-flex align-items-center gap-2">
                            <i class="fa-solid fa-save"></i> <span>Guardar Cambios</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@Scripts.Render("~/bundles/jqueryval")