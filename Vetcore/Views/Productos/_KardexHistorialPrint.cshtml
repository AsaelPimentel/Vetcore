@model IEnumerable<Vetcore.Models.KardexInventario>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Bitácora de Auditoría Kardex - VetCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #ffffff !important;
            color: #0f172a !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px;
        }
        th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            border-bottom: 2px solid #cbd5e1 !important;
            font-size: 9.5pt;
            text-transform: uppercase;
            padding: 8px !important;
        }
        td {
            padding: 8px !important;
            border-bottom: 1px solid #e2e8f0 !important;
            font-size: 9pt;
        }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0 !important; }
        }
    </style>
</head>
<body onload="window.print();">

    <div class="container-fluid">
        <!-- Botón superior secundario de impresión -->
        <div class="text-end mb-3 no-print">
            <button onclick="window.print()" class="btn btn-primary btn-sm shadow-sm">
                <i class="fa-solid fa-print"></i> Imprimir de nuevo
            </button>
        </div>

        <!-- Membrete institucional -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <div>
                <h3 style="margin: 0; font-weight: bold; color: #0f172a; font-size: 16pt;">
                    <i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i> VetCore - Bitácora de Auditoría (Kardex)
                </h3>
                <p class="text-muted small mb-0">Reporte oficial de movimientos, entradas, salidas y mermas de farmacia.</p>
            </div>
            <div class="text-end text-muted small">
                <strong>Fecha de emisión:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <!-- Resumen de filtros aplicados -->
        <div class="p-2 mb-3 bg-light rounded border small text-muted d-flex gap-4">
            <span><strong>Filtros aplicados:</strong></span>
            <span>Tipo: @(string.IsNullOrEmpty(ViewBag.FiltroTipo) ? "Todos" : ViewBag.FiltroTipo)</span>
            <span>Desde: @(string.IsNullOrEmpty(ViewBag.FiltroInicio) ? "N/A" : ViewBag.FiltroInicio)</span>
            <span>Hasta: @(string.IsNullOrEmpty(ViewBag.FiltroFin) ? "N/A" : ViewBag.FiltroFin)</span>
            <span>Total registros: <strong>@Model.Count()</strong></span>
        </div>

        <!-- Tabla detallada -->
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-2">Fecha y Hora</th>
                        <th>Producto</th>
                        <th class="text-center">Movimiento</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-center">Stock Res.</th>
                        <th>Responsable</th>
                        <th>Motivo / Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron movimientos en el kardex con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var k in Model)
                        {
                            bool esEntrada = k.TipoMovimiento == "CompraProveedor" ||
                                             k.TipoMovimiento == "DevolucionCliente" ||
                                             k.TipoMovimiento == "AjusteEntrada" ||
                                             k.TipoMovimiento == "Entrada";
                            <tr>
                                <td class="ps-2 small text-muted">
                                    @(k.FechaHora != null ? ((DateTime)k.FechaHora).ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@k.Productos.Nombre</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@k.TipoMovimiento</span>
                                </td>
                                <td class="text-center fw-bold @(esEntrada ? "text-success" : "text-danger")">
                                    @(esEntrada ? "+" : "-")@k.Cantidad
                                </td>
                                <td class="text-center fw-bold text-dark">
                                    @k.StockResultante
                                </td>
                                <td>
                                    <small class="text-dark">@k.Empleados.Nombre @k.Empleados.Apellidos</small>
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrEmpty(k.Motivo) ? "Sin observaciones" : k.Motivo)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>