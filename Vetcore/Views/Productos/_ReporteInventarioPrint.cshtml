@model IEnumerable<Vetcore.Models.Productos>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte de Inventario - VetCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #ffffff !important;
            color: #0f172a !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }
        .card-modern {
            border: 1px solid #cbd5e1 !important;
            background: #f8fafc !important;
            border-radius: 8px !important;
            padding: 15px !important;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px;
        }
        th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            border-bottom: 2px solid #cbd5e1 !important;
            font-size: 10pt;
            text-transform: uppercase;
            padding: 8px !important;
        }
        td {
            padding: 8px !important;
            border-bottom: 1px solid #e2e8f0 !important;
            font-size: 9.5pt;
        }
        @@media print {
            .no-print { display: none !important; }
        }
    </style>
</head>
<body onload="window.print();">

    <div class="container-fluid">
        <!-- Botón flotante para reintentar imprimir si se cierra la ventana emergente -->
        <div class="text-end mb-3 no-print">
            <button onclick="window.print()" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-print"></i> Imprimir de nuevo
            </button>
        </div>

        <!-- Membrete -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <h3 style="margin: 0; font-weight: bold; color: #0f172a;">VetCore - Reporte de Inventario</h3>
                <p class="text-muted small mb-0">Estado actual de la farmacia, costos de inversión y proyecciones de venta.</p>
            </div>
            <div class="text-end text-muted small">
                <strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <!-- Tarjetas Resumen -->
        <div class="row g-3 mb-4">
            <div class="col-3">
                <div class="card-modern" style="border-left: 4px solid #0284c7 !important;">
                    <span class="text-muted small fw-semibold">Total SKUs</span>
                    <h5 class="fw-bold mb-0 text-dark">@ViewBag.TotalProductos</h5>
                </div>
            </div>
            <div class="col-3">
                <div class="card-modern" style="border-left: 4px solid #d97706 !important;">
                    <span class="text-muted small fw-semibold">Stock Bajo</span>
                    <h5 class="fw-bold mb-0 text-warning">@ViewBag.ProductosStockBajo</h5>
                </div>
            </div>
            <div class="col-3">
                <div class="card-modern" style="border-left: 4px solid #64748b !important;">
                    <span class="text-muted small fw-semibold">Inversión Total</span>
                    <h5 class="fw-bold mb-0 text-dark">$@(((decimal)ViewBag.InversionTotal).ToString("N2"))</h5>
                </div>
            </div>
            <div class="col-3">
                <div class="card-modern" style="border-left: 4px solid #10b981 !important;">
                    <span class="text-muted small fw-semibold">Valor Venta</span>
                    <h5 class="fw-bold mb-0 text-success">$@(((decimal)ViewBag.ValorVentaTotal).ToString("N2"))</h5>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-center">Stock Actual</th>
                        <th class="text-end">Costo Unit.</th>
                        <th class="text-end">Inversión Parcial</th>
                        <th class="text-end">Valor Venta Potencial</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string nombreCategoria = item.Categorias != null ? item.Categorias.Nombre : "Sin Categoría";
                        string codigoStr = string.IsNullOrEmpty(item.CodigoBarras) ? "N/D" : item.CodigoBarras;

                        // Variables seguras para evitar la explosión por NULL
                        bool esServicio = item.StockActual == null;
                        int stockDisponible = item.StockActual ?? 0;

                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.Nombre</div>
                                <small class="text-muted">Cód: @codigoStr</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@nombreCategoria</span>
                            </td>
                            <td class="text-center fw-bold">
                                @(esServicio ? "N/A" : stockDisponible.ToString())
                            </td>
                            <td class="text-end">$@item.PrecioCosto.ToString("N2")</td>

                            <!-- Cálculos protegidos: Si es servicio muestra "-", si es físico multiplica -->
                            <td class="text-end text-muted">
                                @(esServicio ? "-" : "$" + ((decimal)(stockDisponible * item.PrecioCosto)).ToString("N2"))
                            </td>
                            <td class="text-end fw-bold text-success">
                                @(esServicio ? "-" : "$" + ((decimal)(stockDisponible * item.PrecioVenta)).ToString("N2"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>