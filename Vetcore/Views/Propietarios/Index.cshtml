        function loadTable(search, page) {
            $('#table-container').css('opacity', '0.5');
            $.ajax({
                url: '@Url.Action("Index", "Propietarios")',
                type: 'GET',
                data: { search: search, page: page },
                success: function (result) {
                    $('#table-container').html(result).css('opacity', '1');
                }
            });
        }

        function abrirModalCreate() {
            $.ajax({
                url: '@Url.Action("Create", "Propietarios")',
                type: 'GET',
                success: function (data) {
                    $('#modal-container').html(data);
                    $('#modalPropietario').modal('show');
                }
            });
        }

        function abrirModalEdit(id) {
            $.get('@Url.Action("Edit", "Propietarios")/' + id, function (data) {
                $('#modal-container').html(data);
                $('#modalEditPropietario').modal('show');
            });
        }

        function abrirModalDetails(id) {
            $.get('@Url.Action("Details", "Propietarios")/' + id, function (data) {
