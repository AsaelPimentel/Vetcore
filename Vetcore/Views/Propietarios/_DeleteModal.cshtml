@model Vetcore.Models.Propietarios

<div class="modal fade" id="modalDeletePropietario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-modern" style="border: none; padding: 0;">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 3rem; color: #ef4444;"></i>
                </div>
                <h3 class="headline mb-2">¿Eliminar Cliente?</h3>
                <p class="body-text mb-4">Estás a punto de eliminar a <strong>@Model.Nombre @Model.Apellidos</strong>. Esta acción no se puede deshacer.</p>

                <form id="frmDeletePropietario">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.IdPropietario)

                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outlined" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="btnConfirmarEliminar" class="btn" style="background-color: #ef4444; color: white;">
                            Sí, eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>