<!-- Archivo: Views/Shared/_Paginacion.cshtml -->
@if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 px-3 border-top">
        <span class="text-muted small fw-semibold mb-2 mb-md-0">
            Mostrando página @ViewBag.CurrentPage de @ViewBag.TotalPages
        </span>
        <nav>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <!-- Botón Anterior -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link page-link-ajax text-secondary" href="#" data-page="@(ViewBag.CurrentPage - 1)">
                        <i class="fa-solid fa-chevron-left"></i> Anterior
                    </a>
                </li>

                <!-- Números de Página -->
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link page-link-ajax @(ViewBag.CurrentPage == i ? "bg-primary border-primary text-white" : "text-dark")" href="#" data-page="@i">@i</a>
                    </li>
                }

                <!-- Botón Siguiente -->
                <li class="page-item @(ViewBag.CurrentPage == (int)ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link page-link-ajax text-secondary" href="#" data-page="@(ViewBag.CurrentPage + 1)">
                        Siguiente <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}